# ==========================================
# FOUNDER-0 Environment Configuration
# ==========================================

# When MOCK_MODE=true, the system will use realistic offline fixture data & sandbox simulation.
# Set MOCK_MODE=false to invoke live sponsor & provider APIs.
MOCK_MODE=true

# Database: SQLite by default for zero external deps.
# Or PostgreSQL e.g. postgresql+asyncpg://postgres:postgres@localhost:5432/founder0
DATABASE_URL=sqlite+aiosqlite:///./founder0.db

# Daytona API Credentials (https://www.daytona.io/)
DAYTONA_API_KEY=
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Oxylabs Realtime Search & Web Scraper API (https://oxylabs.io/)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Nosana Decentralized GPU LLM Inference (https://nosana.io/)
NOSANA_API_KEY=
NOSANA_BASE_URL=https://api.nosana.io/v1
NOSANA_MODEL_ID=deepseek-coder

# Fallback LLM Provider (when Nosana is unavailable or rate-limited)
FALLBACK_LLM_PROVIDER=anthropic  # 'anthropic', 'openai', or 'ollama'
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=claude-3-5-sonnet-20241022

# Optional TTS Voiceover Provider
TTS_PROVIDER=none  # 'elevenlabs', 'openai', or 'none'
TTS_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
